# Crestus Frontend Environment Configuration

# Production storefront API (set this before building for Hostinger):
# REACT_APP_BACKEND_URL=https://crestus-api.onrender.com
# Leaving this unset uses /api on the storefront host, with bundled catalog fallback.
# When running backend locally:
# REACT_APP_BACKEND_URL=http://localhost:8000

