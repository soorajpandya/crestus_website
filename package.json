{
  "name": "crestus-website",
  "version": "1.0.0",
  "private": true,
  "description": "Crestus website and backend server",
  "main": "backend/server.js",
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "backend": "npm --prefix backend start",
    "frontend": "npm --prefix frontend start",
    "build": "npm run build:frontend",
    "build:frontend": "npm --prefix frontend run build",
    "build:admin": "node scripts/package-admin.cjs",
    "postinstall": "npm --prefix backend ci && npm --prefix frontend ci",
    "start": "node backend/server.js",
    "test": "cd backend && npm test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "firebase-admin": "^12.7.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
