# ---- Server -----------------------------------------------------------------
PORT=8000
NODE_ENV=production
# Production storefront used for payment result pages.
FRONTEND_URL=https://crestuseccommerce.store
# Comma-separated admin e-mails (or set Firebase custom claim admin=true).
ADMIN_EMAILS=admin@crestuseccommerce.store
# Optional Slack-compatible webhook that receives fulfillment alerts.
ADMIN_ALERT_WEBHOOK_URL=

# ---- Razorpay (new checkout orders) -----------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Separate secret configured for /api/webhooks/razorpay in the Razorpay Dashboard.
RAZORPAY_WEBHOOK_SECRET=

# ---- Firebase (Firestore order store + ID-token verification) ---------------
# Provide ONE of the following. ORDER_STORE defaults to "firestore" when credentials exist, else "file".
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_FILE=./crestus.serviceaccount.json
FIREBASE_PROJECT_ID=crestus-6f962
# ORDER_STORE=firestore
# DATA_DIR=./data   (file store location when ORDER_STORE=file)

# ---- Shiprocket -------------------------------------------------------------
# API user credentials (Settings → API → Configure → Create API user). Never the panel login.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Pickup address nickname exactly as configured in Shiprocket, and its postcode.
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_PICKUP_POSTCODE=380015
# Optional custom channel id; leave blank for the default "Custom" channel.
SHIPROCKET_CHANNEL_ID=
# Token configured in Shiprocket → Settings → API → Webhooks; sent back as x-api-key.
SHIPROCKET_WEBHOOK_TOKEN=
# recommended | cheapest | fastest | balanced
COURIER_SELECTION_POLICY=recommended
# Set SHIPROCKET_MOCK=true for local/CI runs: no network calls, deterministic responses.
SHIPROCKET_MOCK=false

# ---- Shipping charge policy (matches the published Shipping Policy) ---------
SHIPPING_CHARGE_MODE=flat
SHIPPING_FLAT_RATE=79
SHIPPING_FREE_ABOVE=1999
GST_RATE_PERCENT=0
APPAREL_HSN_CODE=
PACKAGING_RULES_FILE=./config/packaging.json

# ---- Worker -----------------------------------------------------------------
FULFILLMENT_WORKER_ENABLED=true
FULFILLMENT_POLL_INTERVAL_MS=5000
FULFILLMENT_MAX_ATTEMPTS=6
TRACKING_POLL_INTERVAL_MINUTES=60
PAYMENT_RECONCILE_INTERVAL_MINUTES=10
